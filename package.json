{
  "name": "dalbit-matgo",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node server/index.cjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
